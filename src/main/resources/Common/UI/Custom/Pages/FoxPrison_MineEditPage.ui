$C = "../Common.ui";

$C.@PageOverlay {
  Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);

  $C.@Container {
    Anchor: (Width: 700, Height: 850, Horizontal: 0, Vertical: 0);

    #Title {
      Group {
        TextButton #BackButton {
          Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
          Padding: (Left: 8, Top: 2);
          Text: "< Back";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #b4c8c9, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
        }
        $C.@Title {
          @Text = "Edit Mine";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group #Main {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        // ── Mine Header ────────────────────────────────────────────
        Label #MineNameLabel {
          Anchor: (Top: 4);
          Style: (
            FontSize: 20,
            TextColor: #ffffff,
            RenderBold: true
          );
          Text: "Mine Name";
        }

        Label #MineIdLabel {
          Style: (FontSize: 13, TextColor: #96a9be);
          Text: "ID: unknown";
          Anchor: (Top: 2);
        }

        Label #WorldNameLabel {
          Style: (FontSize: 13, TextColor: #96a9be);
          Text: "World: default";
          Anchor: (Top: 2);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Display Name ───────────────────────────────────────────
        $C.@Subtitle { @Text = "Display Name"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #DisplayNameField {
            FlexWeight: 1;
          }
        }

        Label #DisplayNameInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "The name shown to players";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Order ──────────────────────────────────────────────────
        $C.@Subtitle { @Text = "Order"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #OrderField {
            FlexWeight: 1;
          }
        }

        Label #OrderInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Sort order / tier of this mine (higher = better)";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Auto-Reset: Enabled ────────────────────────────────────
        $C.@Subtitle { @Text = "Auto-Reset"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          Label #AutoResetStatusLabel {
            Style: (FontSize: 15, TextColor: #96a9be, VerticalAlignment: Center);
            Text: "Disabled";
          }

          $C.@SmallSecondaryTextButton #ToggleAutoResetButton {
            @Text = "Toggle";
            Anchor: (Left: 8, Width: 90);
          }
        }

        Label #AutoResetInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Enable or disable automatic mine resets";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Auto-Reset: Interval ───────────────────────────────────
        $C.@Subtitle { @Text = "Reset Interval (seconds)"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #IntervalField {
            FlexWeight: 1;
          }
        }

        Label #IntervalInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Reset every N seconds (0 = disabled)";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Auto-Reset: Block Threshold ────────────────────────────
        $C.@Subtitle { @Text = "Block Broken Threshold"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #ThresholdField {
            FlexWeight: 1;
          }
        }

        Label #ThresholdInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Reset after this many blocks broken (0 = disabled)";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Auto-Reset: Min Delay ──────────────────────────────────
        $C.@Subtitle { @Text = "Min Delay Between Resets (seconds)"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #MinDelayField {
            FlexWeight: 1;
          }
        }

        Label #MinDelayInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Cooldown between consecutive resets";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Region Info ────────────────────────────────────────────
        $C.@Subtitle { @Text = "Region"; }

        Label #RegionInfoLabel {
          Style: (FontSize: 13, TextColor: #96a9be);
          Text: "No region boxes defined";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Allowed Ranks ──────────────────────────────────────────
        $C.@Subtitle { @Text = "Allowed Ranks"; }

        Label #AllowedRanksInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Tick the ranks that can access this mine (none = all)";
          Anchor: (Top: 2, Bottom: 6);
        }

        Group #RankChecks {
          LayoutMode: Top;
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Actions ────────────────────────────────────────────────
        $C.@Subtitle { @Text = "Actions"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@SmallSecondaryTextButton #SaveButton {
            @Text = "Save";
            Anchor: (Width: 100);
          }

          $C.@SmallSecondaryTextButton #TeleportButton {
            @Text = "Teleport";
            Anchor: (Left: 8, Width: 100);
          }

          $C.@SmallSecondaryTextButton #ResetButton {
            @Text = "Reset Mine";
            Anchor: (Left: 8, Width: 110);
          }

          $C.@SmallSecondaryTextButton #SetSpawnButton {
            @Text = "Set Spawn Here";
            Anchor: (Left: 8, Width: 140);
          }

          $C.@CancelTextButton #DeleteButton {
            @Text = "Delete Mine";
            Anchor: (Left: 8, Height: $C.@SmallButtonHeight, Width: 130);
          }
        }
      }
    }
  }
}

