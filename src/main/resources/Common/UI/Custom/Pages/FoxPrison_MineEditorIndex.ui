$C = "../Common.ui";

$C.@PageOverlay {
  Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);

  $C.@Container {
    Anchor: (Width: 620, Height: 550, Horizontal: 0, Vertical: 0);

    #Title {
      TextButton #CloseButton {
        Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
        Padding: (Left: 8, Top: 2);
        Text: "Close";
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #b4c8c9, RenderBold: true)),
          Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
      }
      $C.@Title {
        @Text = "Mine Editor";
      }
    }

    #Content {
      LayoutMode: Top;

      Label {
        Style: (
          FontSize: 16,
          TextColor: #b4c8c9,
          RenderBold: true,
          RenderUppercase: true
        );
        Text: "ALL MINES";
        Anchor: (Bottom: 4);
      }

      Label #TotalMinesLabel {
        Style: (
          FontSize: 13,
          TextColor: #96a9be
        );
        Text: "Total: 0 Mines";
        Anchor: (Bottom: 10);
      }

      Group #IndexList {
        Anchor: (Top: 2);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #IndexCards {
          LayoutMode: Top;
        }
      }
    }
  }
}


