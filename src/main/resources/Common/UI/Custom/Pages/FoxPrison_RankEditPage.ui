$C = "../Common.ui";

$C.@PageOverlay {
  Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);

  $C.@Container {
    Anchor: (Width: 700, Height: 650, Horizontal: 0, Vertical: 0);

    #Title {
      Group {
        TextButton #BackButton {
          Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
          Padding: (Left: 8, Top: 2);
          Text: "< Back";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #b4c8c9, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
        }
        $C.@Title {
          @Text = "Edit Rank";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group #Main {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        // ── Rank Header ────────────────────────────────────────────
        Label #RankNameLabel {
          Anchor: (Top: 4);
          Style: (
            FontSize: 20,
            TextColor: #ffffff,
            RenderBold: true
          );
          Text: "Rank Name";
        }

        Label #RankIdLabel {
          Style: (FontSize: 13, TextColor: #96a9be);
          Text: "ID: unknown";
          Anchor: (Top: 2);
        }

        Label #RankPositionLabel {
          Style: (FontSize: 13, TextColor: #96a9be);
          Text: "Position: 0";
          Anchor: (Top: 2);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Display Name ───────────────────────────────────────────
        $C.@Subtitle { @Text = "Display Name"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #DisplayNameField {
            FlexWeight: 1;
          }
        }

        Label #DisplayNameInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "The name shown to players";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Currency Cost (money) ──────────────────────────────────
        $C.@Subtitle { @Text = "Money Cost"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@TextField #MoneyCostField {
            FlexWeight: 1;
          }
        }

        Label #MoneyCostInfo {
          Style: (FontSize: 12, TextColor: #878e9c);
          Text: "Currency cost to rank up to this rank";
          Anchor: (Top: 4);
        }

        $C.@ContentSeparator { Anchor: (Top: 12, Bottom: 10); }

        // ── Actions ────────────────────────────────────────────────
        $C.@Subtitle { @Text = "Actions"; }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $C.@SmallSecondaryTextButton #SaveButton {
            @Text = "Save";
            Anchor: (Width: 100);
          }

          $C.@CancelTextButton #DeleteButton {
            @Text = "Delete Rank";
            Anchor: (Left: 8, Height: $C.@SmallButtonHeight, Width: 130);
          }
        }
      }
    }
  }
}


